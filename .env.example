# =====================================================================
# Шаблон переменных окружения для sysadmin-usb.
#
# КАК ИСПОЛЬЗОВАТЬ:
#   1. Скопируй: cp .env.example .env
#   2. Поменяй все пароли на свои.
#   3. Файл .env в .gitignore — в git НЕ попадёт.
# =====================================================================

# --- Общие настройки ---
APP_NAME=sysadmin-usb
APP_VERSION=1.0.0
LOG_LEVEL=INFO
TZ=Europe/Moscow

# --- Веб-интерфейс ---
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_SECRET_KEY=CHANGE_ME_SECRET_KEY

# --- Telegram (для алертов) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_CHAT_ID=CHANGE_ME_CHAT_ID

# --- Принтеры (SNMP) ---
SNMP_COMMUNITY=public
SNMP_TIMEOUT=2

# --- Active Directory ---
AD_DOMAIN=company.local
AD_USER=admin
AD_PASSWORD=CHANGE_ME_AD_PASSWORD

# --- PostgreSQL (для истории) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sysadmin_usb
DB_USER=sysadmin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
